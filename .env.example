# Provedor padrão da IA: opencode (gratuito) ou openrouter
AI_PROVIDER=opencode

# OpenCode Zen — opção gratuita padrão
# Gere sua chave no OpenCode Zen e mantenha-a somente no servidor.
OPENCODE_API_KEY=...
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_MODEL=mimo-v2.5-free

# OpenRouter — agregador com vários provedores/modelos
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Atlas Finance

# Opcional: mock mode para desenvolver sem consumir créditos
AI_MOCK=false

# Para desenvolvimento: rode `npm run dev` — Vite serve frontend + /api/ai juntos
# Para preview/produção (Vercel/Netlify): configure as mesmas variáveis no servidor.
