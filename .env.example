# Provedor padrão da IA: opencode (gratuito), openai ou openrouter (legado)
AI_PROVIDER=opencode

# OpenCode Zen — recomendado como opção gratuita padrão
# Gere sua chave no OpenCode Zen e mantenha-a somente no servidor.
OPENCODE_API_KEY=...
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_MODEL=deepseek-v4-flash-free

# OpenAI — opcional
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter — compatibilidade com configurações/deploys antigos
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Atlas Finance

# Opcional: mock mode para desenvolver sem consumir créditos
AI_MOCK=false

# Para desenvolvimento: rode `npm run dev` — Vite serve frontend + /api/ai juntos
# Para preview/produção (Vercel/Netlify): configure as mesmas variáveis no servidor.
