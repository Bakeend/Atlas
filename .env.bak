# OpenRouter API key — NUNCA usar prefixo VITE_ (não expor ao browser)
OPENROUTER_API_KEY=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

# Modelo OpenRouter para IA (ex.: deepseek/deepseek-chat, google/gemini-2.0-flash-001, openai/gpt-4o-mini, etc.)
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Opcional: site/app identification for OpenRouter headers
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Atlas Finance

# Opcional: mock mode para desenvolver sem consumir créditos
AI_MOCK=false

# Para desenvolvimento: rode `npm run dev` — Vite serve frontend + /api/ai juntos
# Para preview/produção (Vercel/Netlify): deploy da pasta /api como serverless funciona automaticamente
